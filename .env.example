# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# MySQL connection (root is fine for local development)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alien_defender

# Session signing secret - generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string
# Log out after this many minutes of inactivity
SESSION_IDLE_MINUTES=15
# Log out after this many hours even if active
SESSION_ABSOLUTE_HOURS=8
# bcrypt cost factor (higher = slower to crack, slower to log in)
BCRYPT_ROUNDS=12

# External API timeouts (milliseconds)
BANANA_API_TIMEOUT_MS=4000
QUOTES_API_TIMEOUT_MS=3000
