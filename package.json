{
  "name": "alienn-defender",
  "version": "0.1.0",
  "description": "Alien Defender: The Last Stand - browser survival shooter with maths puzzles (CIS046-3 Software for Enterprise)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:live": "jest --testMatch **/tests/live/**/*.live.js --verbose",
    "db:migrate": "node scripts/migrate.js",
    "test:db": "jest --testMatch **/tests/db/**/*.db.js --runInBand --verbose"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/preset-env": "^8.0.7",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
